<html>
<head>
    <title>Hello World</title>

    <style>
        /* Sayfa genel ayar */
        body {
            margin: 0;
            padding: 0;
            height: 100vh;

            /* Arka plan gradient */
            background: linear-gradient(135deg, #4facfe, #00f2fe);

            /* Ortalamak için flex */
            display: flex;
            justify-content: center;
            align-items: center;

            font-family: Arial, Helvetica, sans-serif;
        }

        /* Kart tasarımı */
        .container {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 40px 80px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            text-align: center;
        }

        /* Yazı tasarımı */
        h2 {
            margin: 0;
            font-size: 48px;
            color: #333;
        }

        /* Alt açıklama */
        p {
            margin-top: 15px;
            font-size: 18px;
            color: #666;
        }
    </style>
</head>

<body>

    <div class="container">
        <h2>Hello World! 👋</h2>
        <p>Welcome to my beautified web page</p>
    </div>

</body>
</html>